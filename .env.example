# AWS Configuration
AWS_PROFILE=default
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Database (SQLite for MVP)
DATABASE_URL=sqlite:///./cost_sleuth.db

# Server (for future web dashboard)
API_PORT=8000
WEB_PORT=3000

# Feature Flags
ENABLE_AUTO_APPLY=false
SLACK_WEBHOOK_URL=
EMAIL_NOTIFICATIONS=false

# Default Filter Configuration (comma-separated)
EXCLUDE_TAGS=Environment:production
EXCLUDE_INSTANCE_TYPES=

# Analysis Settings
DEFAULT_LOOKBACK_DAYS=30
CONFIDENCE_THRESHOLD=medium
CPU_IDLE_THRESHOLD=5
CPU_UNDERUTILIZED_THRESHOLD=40
